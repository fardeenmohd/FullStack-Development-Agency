{
    "overview": "A robust B2B international trade platform designed to facilitate exports from India to Oman, China, Europe, and Australia. The architecture features a Next.js frontend for a responsive corporate dashboard, a Java Spring Boot core backend managing secure authentication, user profiles, product catalogs, and transaction workflows, and a Python FastAPI compute engine powering the AI 'Lead Hunter' module to scrape, analyze, and score international B2B leads.",
    "database_schema": [
        {
            "table_name": "users",
            "description": "Stores corporate user accounts, roles, and company profiles.",
            "fields": [
                {
                    "name": "id",
                    "type": "UUID",
                    "constraints": "PRIMARY KEY"
                },
                {
                    "name": "email",
                    "type": "VARCHAR(255)",
                    "constraints": "UNIQUE, NOT NULL"
                },
                {
                    "name": "password_hash",
                    "type": "VARCHAR(255)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "company_name",
                    "type": "VARCHAR(255)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "role",
                    "type": "VARCHAR(50)",
                    "constraints": "NOT NULL (EXPORTER, IMPORTER, ADMIN)"
                },
                {
                    "name": "country",
                    "type": "VARCHAR(100)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "iec_code",
                    "type": "VARCHAR(50)",
                    "constraints": "NULLABLE (Import Export Code for Indian Exporters)"
                },
                {
                    "name": "created_at",
                    "type": "TIMESTAMP",
                    "constraints": "DEFAULT CURRENT_TIMESTAMP"
                }
            ]
        },
        {
            "table_name": "products",
            "description": "Export goods listed by Indian exporters with HS codes.",
            "fields": [
                {
                    "name": "id",
                    "type": "UUID",
                    "constraints": "PRIMARY KEY"
                },
                {
                    "name": "exporter_id",
                    "type": "UUID",
                    "constraints": "FOREIGN KEY REFERENCES users(id)"
                },
                {
                    "name": "name",
                    "type": "VARCHAR(255)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "hs_code",
                    "type": "VARCHAR(12)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "description",
                    "type": "TEXT",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "target_regions",
                    "type": "VARCHAR[]",
                    "constraints": "NOT NULL (e.g., ['OM', 'CN', 'EU', 'AU'])"
                },
                {
                    "name": "created_at",
                    "type": "TIMESTAMP",
                    "constraints": "DEFAULT CURRENT_TIMESTAMP"
                }
            ]
        },
        {
            "table_name": "leads",
            "description": "AI-discovered international buyer leads generated by the Lead Hunter engine.",
            "fields": [
                {
                    "name": "id",
                    "type": "UUID",
                    "constraints": "PRIMARY KEY"
                },
                {
                    "name": "exporter_id",
                    "type": "UUID",
                    "constraints": "FOREIGN KEY REFERENCES users(id)"
                },
                {
                    "name": "company_name",
                    "type": "VARCHAR(255)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "country",
                    "type": "VARCHAR(100)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "contact_email",
                    "type": "VARCHAR(255)",
                    "constraints": "NULLABLE"
                },
                {
                    "name": "confidence_score",
                    "type": "DECIMAL(5,2)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "source_url",
                    "type": "TEXT",
                    "constraints": "NULLABLE"
                },
                {
                    "name": "status",
                    "type": "VARCHAR(50)",
                    "constraints": "DEFAULT 'NEW' (NEW, CONTACTED, CONCLUDED, REJECTED)"
                },
                {
                    "name": "created_at",
                    "type": "TIMESTAMP",
                    "constraints": "DEFAULT CURRENT_TIMESTAMP"
                }
            ]
        },
        {
            "table_name": "transactions",
            "description": "Tracks trade agreements, escrow status, and shipping milestones.",
            "fields": [
                {
                    "name": "id",
                    "type": "UUID",
                    "constraints": "PRIMARY KEY"
                },
                {
                    "name": "lead_id",
                    "type": "UUID",
                    "constraints": "FOREIGN KEY REFERENCES leads(id)"
                },
                {
                    "name": "exporter_id",
                    "type": "UUID",
                    "constraints": "FOREIGN KEY REFERENCES users(id)"
                },
                {
                    "name": "contract_value",
                    "type": "DECIMAL(15,2)",
                    "constraints": "NOT NULL"
                },
                {
                    "name": "currency",
                    "type": "VARCHAR(3)",
                    "constraints": "DEFAULT 'USD'"
                },
                {
                    "name": "status",
                    "type": "VARCHAR(50)",
                    "constraints": "DEFAULT 'INITIATED' (INITIATED, ESCROW_LOCKED, SHIPPED, DELIVERED, COMPLETED)"
                },
                {
                    "name": "updated_at",
                    "type": "TIMESTAMP",
                    "constraints": "DEFAULT CURRENT_TIMESTAMP ON UPDATE"
                }
            ]
        }
    ],
    "api_contracts": [
        {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "description": "Registers a new corporate user (Exporter or Importer).",
            "owner": "Java (Spring Boot)"
        },
        {
            "method": "POST",
            "path": "/api/v1/auth/login",
            "description": "Authenticates user and returns a secure JWT token.",
            "owner": "Java (Spring Boot)"
        },
        {
            "method": "GET",
            "path": "/api/v1/dashboard/metrics",
            "description": "Fetches aggregated trade metrics, active leads, and transaction statuses for the corporate dashboard.",
            "owner": "Java (Spring Boot)"
        },
        {
            "method": "POST",
            "path": "/api/v1/products",
            "description": "Registers a new product with HS codes for export targeting.",
            "owner": "Java (Spring Boot)"
        },
        {
            "method": "GET",
            "path": "/api/v1/leads",
            "description": "Retrieves saved and AI-generated leads for the authenticated exporter.",
            "owner": "Java (Spring Boot)"
        },
        {
            "method": "POST",
            "path": "/api/v1/compute/hunt-leads",
            "description": "Triggers the AI Lead Hunter engine to scrape and identify potential buyers in target countries based on HS codes and product descriptions.",
            "owner": "Python (FastAPI)"
        },
        {
            "method": "POST",
            "path": "/api/v1/compute/score-lead",
            "description": "Evaluates and scores a specific lead's legitimacy and compliance risk using NLP and historical trade data.",
            "owner": "Python (FastAPI)"
        },
        {
            "method": "POST",
            "path": "/api/v1/transactions",
            "description": "Initiates a trade contract and escrow workflow between an exporter and a lead.",
            "owner": "Java (Spring Boot)"
        }
    ]
}